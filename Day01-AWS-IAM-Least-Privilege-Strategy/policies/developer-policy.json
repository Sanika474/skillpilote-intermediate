{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ProjectS3Access",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::skillpilote-cloudapp-872376836627-ap-south-1"
    },
    {
      "Sid": "ProjectS3ObjectAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::skillpilote-cloudapp-872376836627-ap-south-1/*"
    },
    {
      "Sid": "InvokeProjectLambda",
      "Effect": "Allow",
      "Action": "lambda:InvokeFunction",
      "Resource": "arn:aws:lambda:ap-south-1:872376836627:function:SkillPilote-CloudApp-Function"
    },
    {
      "Sid": "ProjectDynamoDBAccess",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:Query"
      ],
      "Resource": [
        "arn:aws:dynamodb:ap-south-1:872376836627:table/SkillPilote-CloudApp-Records",
        "arn:aws:dynamodb:ap-south-1:872376836627:table/SkillPilote-CloudApp-Records/index/*"
      ]
    },
    {
      "Sid": "ReadProjectLogs",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogStreams",
        "logs:GetLogEvents",
        "logs:FilterLogEvents"
      ],
      "Resource": "arn:aws:logs:ap-south-1:872376836627:log-group:/aws/lambda/SkillPilote-CloudApp-Function:*"
    }
  ]
}